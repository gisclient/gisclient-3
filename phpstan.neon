parameters:
    phpVersion: 70400
    level: 0
    paths:
        - src
        - lib
        - public
        - tests
    tmpDir: var/cache/phpstan
    bootstrapFiles:
        # stub for mapscript functions
        - stubs/mapscript-stubs.php
    ignoreErrors:
        # docs say it returns void, but it's used to fetch a string, so very unclear
        - '#Result of function ms_iogetstdoutbufferstring \(void\) is used.#'
