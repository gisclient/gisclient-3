{
    "name": "gisclient/author",
    "type": "application",
    "description": "GisClient Author",
    "keywords": ["application", "mapserver"],
    "homepage": "http://gisclient.net",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4.0",
        "ext-curl": "*",
        "ext-dom": "*",
        "phpoffice/phpexcel": "^1.8",
        "sentry/sentry": "^4.23",
        "symfony/config": "^3.4",
        "symfony/console": "^3.4",
        "symfony/dependency-injection": "^3.4",
        "symfony/dotenv": "^3.4",
        "symfony/filesystem": "^3.4",
        "symfony/form": "^3.4",
        "symfony/http-foundation": "^3.4",
        "symfony/http-kernel": "^3.4",
        "symfony/process": "^3.4",
        "symfony/routing": "^3.4",
        "symfony/validator": "^3.4",
        "symfony/yaml": "^3.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^1.2",
        "symfony/phpunit-bridge": "^7.2",
        "symplify/easy-coding-standard": "^12.3"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "GisClient\\": "src/"
        },
        "classmap": [
            "lib/gcapp.class.php",
            "lib/GCService.php"
        ],
        "files": [
            "lib/debug.php"
        ]
    },
    "scripts": {
        "create-writable-directories": [
            "mkdir -p config/debug",
            "mkdir -p files",
            "mkdir -p fonts",
            "mkdir -p import",
            "mkdir -p map/tmp",
            "mkdir -p pixmap",
            "mkdir -p public/services/tmp/export",
            "mkdir -p public/services/print/tmp",
            "mkdir -p public/services/documents",
            "mkdir -p public/admin/export",
            "mkdir -p tmp/files",
            "mkdir -p tmp/sess",
            "mkdir -p var/cache",
            "mkdir -p var/offline"
        ],
        "fix-writable-permissions": [
            "chmod 777 config/debug",
            "chmod 777 files",
            "chmod 777 import",
            "chmod 777 map",
            "chmod 777 map/tmp",
            "chmod 777 pixmap",
            "chmod 777 public/services/tmp/export",
            "chmod 777 public/services/print/tmp",
            "chmod 777 public/services/documents",
            "chmod 777 public/admin/export",
            "chmod 777 tmp/files",
            "chmod 777 tmp/sess",
            "chmod -R 777 var"
        ],
        "post-install-cmd": [
            "@create-writable-directories",
            "@fix-writable-permissions"
        ],
        "post-update-cmd": [
            "@create-writable-directories",
            "@fix-writable-permissions"
        ],
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=-1",
        "phpstan-ci": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=-1 --no-progress",
        "ecs": "vendor/bin/ecs check --ansi --memory-limit=-1",
        "ecs-ci": "vendor/bin/ecs check --no-progress-bar --memory-limit=-1",
        "ecs-fix": "vendor/bin/ecs check --fix --ansi --memory-limit=-1",
        "rector": "vendor/bin/rector --dry-run",
        "rector-ci": "vendor/bin/rector --dry-run --no-progress-bar",
        "rector-fix": "vendor/bin/rector",
        "test": "vendor/bin/phpunit -c ./phpunit.xml.dist",
        "test-ci": "vendor/bin/phpunit -c ./phpunit.xml.dist --stop-on-failure"
    },
    "config": {
        "sort-packages": true
    }
}
